    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "MiniMax 令牌套餐"
        }
      }
    }
  },
  "\"12% used · 88% left\", so a reading lines up with whichever end your vendor happens to show.": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "“已用 12% · 剩余 88%”，方便与供应商显示的用量或余额对照。"
        }
      }
    }
  },
