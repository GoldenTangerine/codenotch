{
  "sourceLanguage" : "en",
  "strings" : {
  "Complete Chinese copy and clearer live request counts.": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "补齐中文文案，让实时调用数量更醒目。"
        }
      }
    }
  },
  "Chinese throughout the new features": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "补齐新增功能的中文"
        }
      }
    }
  },
  "Settings, menus, notifications, provider guidance, session activity, reset countdowns and release history now use localized copy.": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "设置、菜单、通知、供应商说明、会话活动、重置倒计时和更新历史现已完整接入本地化。"
        }
      }
    }
  },
  "Live request counts stand out": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "实时调用数量更醒目"
        }
      }
    }
  },
  "In Code Switch R details, Calling follows your accent color while the count stays bold green with monospaced digits.": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "Code Switch R 详情中的“调用中”跟随强调色，数量独立显示为绿色加粗，并使用等宽数字。"
        }
      }
    }
  },
    "Calling": {
