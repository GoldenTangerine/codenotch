    },
    "Asks macOS for %@'s saved login again. Choose Always Allow and it will stop asking." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让 macOS 再次询问 %@ 的已存登录信息。选择「始终允许」后不再询问。"
          }
        }
      }
    },
    "Bottom" : {
      "comment" : "Screen edge.",
      "extractionState" : "manual",
